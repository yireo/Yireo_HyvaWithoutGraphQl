<?php
declare(strict_types=1);

/**
 * Drop-in replacement for the deprecated GraphQL based Hyvä product slider. The markup is kept
 * identical, but the product data is fetched from a regular Magento controller.
 *
 * @see hyva-themes/magento2-default-theme/Magento_Theme/templates/elements/slider.phtml
 */

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\ProductCompare;
use Hyva\Theme\ViewModel\Wishlist;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\HyvaWithoutGraphQl\ViewModel\Endpoints;
use Yireo\HyvaWithoutGraphQl\ViewModel\SliderParameters;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var Wishlist $wishlistViewModel */
$wishlistViewModel = $viewModels->require(Wishlist::class);

/** @var ProductCompare $compareViewModel */
$compareViewModel = $viewModels->require(ProductCompare::class);

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);

/** @var Endpoints $endpoints */
$endpoints = $viewModels->require(Endpoints::class);

/** @var SliderParameters $sliderParameters */
$sliderParameters = $viewModels->require(SliderParameters::class);

$uniqueId = '_' . uniqid();
$title = $block->getTitle();
$sliderUrl = $endpoints->getSliderProductsUrl()
    . '?' . http_build_query($sliderParameters->getRequestParameters($block));
?>
<script>
    function initSliderComponent<?= /** @noEscape */ $uniqueId ?>() {
        return {
            active: 0,
            products: [],
            loading: true,
            pageSize: 4,
            pageFillers: 0,
            minHeight() {
                return 'min-height: ' + ((this.loading && '650px') || 0);
            },
            getProducts() {
                return fetch('<?= $escaper->escapeJs($sliderUrl) ?>', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then((response) => response.json())
                    .then((data) => {
                        this.products = (data && data.items) || [];
                    })
                    .catch(() => {
                        this.products = [];
                    })
                    .finally(() => {
                        this.loading = false;
                        this.$nextTick(() => this.calcPageSize());
                    });
            },
            addToWishlist() {
                const productId = this.product.id;
                const formKey = hyva.getFormKey();
                const postUrl = BASE_URL + 'wishlist/index/add/';

                fetch(postUrl, {
                    "headers": {
                        "content-type": "application/x-www-form-urlencoded; charset=UTF-8",
                    },
                    "body": "form_key=" + formKey + "&product=" + productId + "&uenc=" + hyva.getUenc(),
                    "method": "POST",
                    "mode": "cors",
                    "credentials": "include"
                }).then(function (response) {
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else if (response.ok) {
                        return response.json();
                    } else {
                        typeof window.dispatchMessages !== "undefined" && window.dispatchMessages(
                            [{
                                type: "warning",
                                text: "<?= $escaper->escapeJs(__('Could not add item to wishlist.')) ?>"
                            }], 5000
                        );
                    }
                }).then(function (response) {
                    if (!response) { return }
                    typeof window.dispatchMessages !== "undefined" && window.dispatchMessages(
                        [{
                            type: (response.success) ? "success" : "error",
                            text: (response.success)
                                ? "<?= $escaper->escapeJs(
                                    __("%1 has been added to your Wish List.", __("Product"))
                                ) ?>" : response.error_message
                        }], 5000
                    );
                    const reloadCustomerDataEvent = new CustomEvent("reload-customer-section-data");
                    window.dispatchEvent(reloadCustomerDataEvent);
                }).catch(function (error) {
                    typeof window.dispatchMessages !== "undefined" && window.dispatchMessages(
                        [{
                            type: "error",
                            text: error
                        }], 5000
                    );
                });
            },
            addToCompare() {
                const formKey = hyva.getFormKey();
                const postUrl = BASE_URL + 'catalog/product_compare/add/';

                fetch(postUrl, {
                    "headers": {
                        "content-type": "application/x-www-form-urlencoded; charset=UTF-8",
                    },
                    "body": "form_key=" + formKey + "&product=" + this.product.id + "&uenc=" + hyva.getUenc(),
                    "method": "POST",
                    "mode": "cors",
                    "credentials": "include"
                }).then(function (response) {
                    if (response.redirected) {
                        window.location.href = response.url;
                    }
                }).catch(function (error) {
                    typeof window.dispatchMessages !== "undefined" && window.dispatchMessages(
                        [{
                            type: "error",
                            text: error
                        }], 5000
                    );
                });
            },
            getSlider() {
                return this.$root.querySelector('.js_slides');
            },
            calcPageSize() {
                const slider = this.getSlider();
                if (slider) {
                    this.pageSize = Math.round(slider.clientWidth / slider.querySelector('.js_slide').clientWidth);
                    this.pageFillers = (
                        this.pageSize * Math.ceil(this.products.length / this.pageSize)
                    ) - this.products.length;
                }
            },
            calcActive() {
                const slider = this.getSlider();
                if (slider) {
                    this.active = Math.ceil(
                        Math.round(
                            slider.scrollLeft / (slider.scrollWidth / this.products.length)
                        ) / this.pageSize
                    ) * this.pageSize;
                }
            },
            onResize() {
                this.calcPageSize();
                this.$nextTick(() => this.calcActive());
            },
            hasProducts() {
                return this.products && this.products.length;
            },
            getProductUrl() {
                return '<?= $escaper->escapeJs($block->getBaseUrl()) ?>' + this.product.url_key + (this.product.url_suffix || '');
            },
            getProductPrice() {
                return hyva.formatPrice(this.product.price_range.minimum_price.final_price.value);
            },
            fillerSlideClasses() {
                const fillerSlideNumber = this.$el.dataset.fillerSlideNumber;
                return {
                    'js_dummy_slide w-full md:w-1/2 lg:w-1/3 xl:w-1/4 flex-none py-1': this.pageFillers > fillerSlideNumber - 1
                }
            },
            hasMultiplePages() {
                return this.products.length && this.products.length > this.pageSize;
            },
            getPrevButtonClasses() {
                return {
                    'invisible': this.active === 0
                }
            },
            goPreviousPage() {
                this.getSlider().scrollLeft = (this.getSlider().scrollWidth / this.products.length) * (this.active - this.pageSize);
                this.active = this.active - this.pageSize;
            },
            getBulletClasses() {
                return {
                    'bg-opacity-100': this.active === this.index,
                    'bg-opacity-25': this.active !== this.index,
                    'hidden': (this.pageSize !== 1 && !!(this.index % this.pageSize)),
                };
            },
            goToPage() {
                this.getSlider().scrollLeft = (this.getSlider().scrollWidth / this.products.length) * this.index;
                this.active = this.index;
            },
            nextButtonClasses() {
                return {
                    'invisible': this.active >= this.products.length - this.pageSize
                }
            },
            goNextPage() {
                this.getSlider().scrollLeft = (this.getSlider().scrollWidth / this.products.length) * (this.active + this.pageSize);
                this.active = this.active + this.pageSize;
            }
        }
    }
    window.addEventListener(
        'alpine:init',
        () => Alpine.data('initSliderComponent<?= /** @noEscape */ $uniqueId ?>', initSliderComponent<?= /** @noEscape */ $uniqueId ?>),
        {once: true}
    )
</script>
<?php if (isset($hyvaCsp)): ?>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
<section class="my-12 text-gray-700"
         x-data="initSliderComponent<?= /** @noEscape */ $uniqueId ?>"
         x-init="getProducts"
         :style="minHeight"
         @resize.window.debounce="onResize"
>
    <template x-if="hasProducts">
        <div class="relative">
            <?php if ($title): ?>
                <div class="container flex flex-col items-center pt-6 pb-3 mx-auto mb-6 border-b-2
                    border-gray-300 md:flex-row">
                    <h3 class="text-2xl font-medium text-gray-900 title-font">
                        <?= $escaper->escapeHtml($title); ?>
                    </h3>
                </div>
            <?php endif; ?>
            <div class="relative w-full overflow-x-hidden focus-within:ring-1 active:ring-0 ring-blue-500/50">
                <div class="relative flex flex-nowrap w-full overflow-auto js_slides snap"
                    <?php if ($title): ?>
                        id="<?= $escaper->escapeHtmlAttr(strtolower(str_replace(' ', '-', trim($title)))) ?>"
                    <?php endif; ?>
                     @scroll.debounce="calcActive"
                >
                    <template x-for="product in products">
                        <div class="flex-none w-full py-1 js_slide md:w-1/2 lg:w-1/3 xl:w-1/4">
                            <div class="mx-1 card card-interactive">
                                <a :href="getProductUrl"
                                   class="relative flex items-center bg-white product photo product-item-photo"
                                   style="padding-top:100%"
                                   tabindex="-1">
                                    <span class="absolute top-0 left-0 flex flex-wrap content-center w-full h-full p-2
                                        overflow-hidden align-center hover:shadow-sm">
                                        <img class="self-center w-full h-auto"
                                             :src="product.small_image.url"
                                             :alt="product.small_image.label"
                                             loading="lazy"
                                             width="500"
                                             height="500"
                                        >
                                    </span>
                                </a>

                                <p class="flex items-center justify-center px-1 pt-3">
                                    <a class="truncate product-item-link" :href="getProductUrl">
                                        <span x-text="product.name"></span>
                                    </a>
                                </p>
                                <p class="pt-1 text-lg text-center text-gray-900"
                                   x-text="getProductPrice"></p>
                                <p class="flex flex-wrap gap-2 px-1 pt-3">
                                    <a class="justify-center w-auto mr-auto btn btn-primary"
                                       :href="getProductUrl">
                                        <span class="inline"><?= $escaper->escapeHtml(__('View Product')) ?></span>
                                    </a>
                                    <span class="inline-flex gap-2 ml-auto">
                                        <?php if ($compareViewModel->showInProductList()): ?>
                                            <button @click.prevent="addToCompare"
                                                    aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>"
                                                    class="rounded-full w-10 h-10 bg-gray-200 p-0 border-0 inline-flex
                                                    items-center justify-center text-gray-500 hover:text-yellow-500"
                                                    data-addto="compare"
                                            >
                                            <?= $heroicons->scaleHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                                        </button>
                                        <?php endif; ?>
                                        <?php if ($wishlistViewModel->isEnabled()): ?>
                                            <button
                                                aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                                                @click.prevent="addToWishlist"
                                                class="inline-flex items-center justify-center w-10 h-10 p-0 ml-auto
                                            text-gray-500 bg-gray-200 border-0 rounded-full hover:text-red-600"
                                                data-addto="wishlist"
                                            >
                                            <?= $heroicons->heartHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                                        </button>
                                        <?php endif; ?>
                                    </span>
                                </p>
                            </div>
                        </div>
                    </template>
                    <div :class="fillerSlideClasses" data-filler-slide-number="1"></div>
                    <div :class="fillerSlideClasses" data-filler-slide-number="2"></div>
                    <div :class="fillerSlideClasses" data-filler-slide-number="3"></div>
                </div>
            </div>
            <div style="min-height: 76px">
            <template x-if="hasMultiplePages">
                <div class="flex items-center justify-center flex-1 p-4">
                    <button
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Previous')) ?>"
                        tabindex="-1"
                        class="w-8 h-8 mx-4 text-black rounded-full outline-none focus:outline-none"
                        :class="getPrevButtonClasses"
                        @click="goPreviousPage">
                        <?= $heroicons->chevronLeftHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                    </button>
                    <template x-for="(product, index) in products" :key="index">
                        <span class="shrink-0 block w-3 h-3 mx-1 bg-black bg-opacity-25 rounded-full shadow cursor-pointer"
                              tabindex="-1"
                              :class="getBulletClasses"
                              @click="goToPage">
                        </span>
                    </template>
                    <button
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Next')) ?>"
                        tabindex="-1"
                        class="w-8 h-8 mx-4 text-black rounded-full outline-none focus:outline-none"
                        :class="nextButtonClasses"
                        @click="goNextPage">
                        <?= $heroicons->chevronRightHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                    </button>
                </div>
            </template>
            </div>
        </div>
    </template>
</section>
